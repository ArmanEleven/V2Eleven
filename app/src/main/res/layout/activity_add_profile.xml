<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050507"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- ═══════════════════════════════════════ -->
        <!-- ELEVEN HEADER -->
        <!-- ═══════════════════════════════════════ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_eleven_logo"
                android:gravity="center"
                android:text="11"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD PROFILE"
                    android:textColor="#FFF5F5"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="V2 ELEVEN"
                    android:textColor="#FF2633"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!-- DIRECT CONFIG -->
        <!-- ═══════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIRECT CONFIG"
            android:textColor="#FF2633"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eleven_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paste VLESS, VMess or JSON configuration"
                android:textColor="#B8A5A5"
                android:textSize="12sp"
                android:paddingBottom="9dp"/>

            <EditText
                android:id="@+id/etConfig"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:hint="vless://...  or  vmess://..."
                android:textColorHint="#5F4F53"
                android:textColor="#FFF5F5"
                android:background="@drawable/bg_eleven_input"
                android:padding="13dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:fontFamily="monospace"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="IMPORT CONFIG"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:backgroundTint="#C90814"
                app:cornerRadius="12dp"
                app:rippleColor="#55FF3344"/>
        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!-- QR -->
        <!-- ═══════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QR CONNECTION"
            android:textColor="#FF2633"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:paddingTop="22dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eleven_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import a server using a QR code"
                android:textColor="#B8A5A5"
                android:textSize="12sp"
                android:paddingBottom="11dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SCAN QR WITH CAMERA"
                android:textColor="#FF5260"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:strokeColor="#7F222A"
                app:strokeWidth="1dp"
                app:cornerRadius="11dp"
                app:rippleColor="#33FF2633"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickQrImage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="PICK QR FROM GALLERY"
                android:textColor="#C4A5A8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:strokeColor="#4A272C"
                app:strokeWidth="1dp"
                app:cornerRadius="11dp"
                app:rippleColor="#33FF2633"/>
        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!-- SUBSCRIPTION -->
        <!-- ═══════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUBSCRIPTION"
            android:textColor="#FF2633"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:paddingTop="22dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_eleven_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add a subscription URL"
                android:textColor="#B8A5A5"
                android:textSize="12sp"
                android:paddingBottom="11dp"/>

            <EditText
                android:id="@+id/etSubName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Subscription name"
                android:textColorHint="#5F4F53"
                android:textColor="#FFF5F5"
                android:textSize="13sp"
                android:background="@drawable/bg_eleven_input"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etSubUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="https://..."
                android:textColorHint="#5F4F53"
                android:textColor="#FFF5F5"
                android:textSize="13sp"
                android:background="@drawable/bg_eleven_input"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:inputType="textUri"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSubscription"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="ADD SUBSCRIPTION"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:backgroundTint="#8B0000"
                app:cornerRadius="12dp"
                app:rippleColor="#55FF3344"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELEVEN PRO  •  ARMAN PING"
            android:textColor="#4F3E42"
            android:textSize="9sp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingTop="22dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

</ScrollView>